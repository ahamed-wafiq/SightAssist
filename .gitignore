# ==============================================================================
# SightAssist - Root .gitignore
# ==============================================================================

# Model Binaries & Weights (Excluded from version control, except production best.pt)
*.pt
*.pth
*.onnx
*.engine
*.bin
!ml/model/best.pt


# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.auto-accept.json

# Dependencies
node_modules/
package-lock.json.bak

# Python Environments & Bytecode
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Build Outputs & Bundles
dist/
dist-ssr/
build/
out/
*.egg-info/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
